# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

############################
# Node / Next.js
############################
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

.next/
out/
build/
dist/
.vercel/
.turbo/
.swc/
*.tsbuildinfo
next-env.d.ts

############################
# Logs & coverage
############################
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
coverage/
*.log

############################
# Env & secrets
############################
# Never commit ANY env files
.env*
# Local Firebase/Gmail/OpenAI/etc. credentials for automation
automation/*.json

############################
# Python (automation)
############################
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.envrc
.pytest_cache/
.poetry/
pip-wheel-metadata/

############################
# OS / Editors
############################
.DS_Store
Thumbs.db
*.pem
.vscode/
.idea/
.claude/
*.code-workspace
